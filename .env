# The store your theme renders against.
# Switch it any time with: salla theme dev --store
VITE_STORE_DOMAIN=99798265

# Twilight SDK build override. Left unset so the store's pinned version
# (theme.twilight.version) or the engine's own default is used instead --
# VITE_TWILIGHT_URL takes priority over everything with no version floor,
# so a pin left here goes stale silently. Set one only if you need to:
# VITE_TWILIGHT_URL=https://cdn.salla.network/js/twilight/<version>/twilight.esm.js
