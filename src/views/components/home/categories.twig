


<section class="s-block container">

	<div class="s-block__title">
		<div class="right-side">
		  <h2>{{ component.title }}</h2>
		</div>
	</div>

	<div class="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-x-4 gap-y-4">
		{% for cat in component.categories %}
			<a href="{{ cat.url }}" class="w-full cat-entry-br group justify-self-center text-bc flex flex-col gap-2 p-1 items-center justify-between">
				
				<div class="md:w-24 md:h-24 w-20 h-20 flex justify-center items-center text-xl rounded-full bg-base-50 border border-bc overflow-hidden">
					{% if cat.image %}
						<img src="{{ cat.image }}" class="w-full transition group-hover:scale-110 h-full object-cover" />
					{% else %}
						<i class="{{ cat.icon }} group-hover:scale-110 transition"></i>
					{% endif %}
				</div>	

        <div class="text-center text-sm md:font-bold line-clamp-2">
          <span title="{{ cat.name }}">
            {{ cat.name }}
          </span>
        </div>

			</a>
		{% endfor %}
	</div>

</section>
