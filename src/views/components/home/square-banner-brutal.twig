

<section class="s-block container">
	<!-- for big screens -->
	<div class="hidden md:grid w-full h-[40rem] grid-cols-3 grid-rows-3 gap-4">
		{% for index, banner in component.banners %}
			<a 
				href="{{banner.url}}" 
				class="text-bc p-4 group flex justify-center items-end rounded-neo border-2 border-bc bg-center bg-no-repeat {% if index == 0 or index == 2 or index == 3 %} row-span-2 {% endif %}"
				style="
					background-image: url({{banner.image}});
					background-size: {{ theme.settings.get('squar_photo_bg_image_size', 'cover') }};
				"
			>
				<div class="p-2 border border-bc rounded-neo bg-base-100 transition group-hover:-translate-y-2 shadow-neo">
                    <p class="text-base font-bold">{{banner.title}}</p>
				</div>
			</a>
		{% endfor %}
	</div>

	<!-- for small screens -->
	<div class="grid md:hidden w-full h-[45rem] grid-cols-2 grid-rows-5 gap-3">
		{% for index, banner in component.banners %}
			<a 
				href="{{banner.url}}" 
				class="text-bc p-2 group flex justify-center items-end rounded-neo border-2 border-bc bg-center bg-no-repeat {% if index == 0 or index == 2 or index == 3 or index == 4 %} row-span-2 {% endif %}"
				style="
					background-image: url({{banner.image}});
					background-size: {{ theme.settings.get('squar_photo_bg_image_size', 'cover') }};
				"
			>
				<div class="p-2 border border-bc rounded-neo bg-base-100 transition group-hover:-translate-y-2">
                    <p class="text-xs font-bold sm:text-sm">{{banner.title}}</p>
				</div>
			</a>
		{% endfor %}
	</div>
</section>
