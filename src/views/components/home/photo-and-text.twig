
<section class="s-block container">
	
	<div class="flex flex-col sm:flex-row border-2 border-bc rounded-neo shadow-neo overflow-hidden sm:max-h-[80dvh]">
		<img class="lazy w-full object-cover border-b-2 sm:border-b-0 sm:ltr:border-r-2 sm:rtl:border-l-2 border-bc" src="{{ component.image }}" />
		<div class="w-full p-8 md:p-14 flex flex-col gap-6 lg:gap-8 justify-center">
			<h2 class="text-xl md:text-2xl lg:text-3xl">{{component.main_title}}</h2>
			{% if component.sub_text %}
				<p class="text-sm md:text-base lg:text-lg">{{component.sub_text}}</p>
			{% endif %}
			{% if component.link_title and component.link_url %}
				<salla-button href="{{ component.link_url }}">
					{{ component.link_title }}
				</salla-button>
			{% endif %}
		</div>
	</div>

</section>
