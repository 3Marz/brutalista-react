
<section class="s-block container">

	{% if component.title %}
		<div class="s-block__title">
			<div class="right-side">
				<h2>{{ component.title }}</h2>
			</div>
		</div>
	{% endif %}

	<div class="grid md:grid-cols-3 md:grid-flow-col gap-5">
		{% for index, link in component.links %}
			<a href="{{link.url}}" class="flex group flex-col gap-2 w-full h-full {%if index == 2%} row-span-2 col-span-2 {%endif%}">
				<div class="w-full h-full rounded-neo overflow-hidden aspect-square border-2 border-bc shadow-neo ">
					<img class="lazy w-full h-full object-cover transition group-hover:scale-105 duration-300" src="{{ link.image }}" />
				</div>
				<div class="text-lg md:text-xl items-center flex gap-2">
					<p>{{ link.name }}</p>
					<i class="group-hover:ltr:translate-x-1 group-hover:rtl:-translate-x-1 rtl:rotate-180 transition sicon-arrow-right"></i>
				</div>
			</a>
		{% endfor %}
	</div>
</section>
