
<section class="s-block container">

	{% if component.title %}
		<div class="s-block__title">
			<div class="right-side">
				<h2>{{ component.title }}</h2>
			</div>
		</div>
	{% endif %}

	<div class="grid md:grid-cols-3 md:grid-flow-col gap-3">
		{% for index, link in component.links %}
			<a class="flex flex-col gap-2 w-full h-full {%if index == 2%} row-span-2 col-span-2 {%endif%}">
				<img class="lazy w-full h-full aspect-squarea border-2 border-bc shadow-neo" src="{{ link.image }}" />
				<p>{{ link.name }}</p>
			</a>
		{% endfor %}
	</div>
</section>
