
<section class="s-block container overflow-hidden">
	<salla-slider
		type="fullwidth"
		centered
		class="discount-offer-slider"
		show-controls="true"
		id="offers-products-slider-{{ position }}"
	>
		<div slot="items">
			{% for offer in component.offers %}
				<div class="w-[80%] mx-3 md:mx-4 flex flex-col gap-4">
					<h2 class="text-lg text-center underline underline-offset-8 md:text-xl font-bold">{{ offer.title }}</h2>
					<discount-product-card product-id="{{ offer.product[0] }}" offer-title="{{ offer.title }}"></discount-product-card> 
				</div>
			{% endfor %}
		</div>
	</salla-slider>
</section>
