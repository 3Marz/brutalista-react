
<section class="s-block container overflow-hidden">
	<salla-slider
		type="carousel"
		auto-height
	>
		<div slot="items">
			{% for offer in component.offers %}
				<div class="w-full flex flex-col md:flex-row gap-3">

					<custom-salla-product-card product="{{ offer.product[0].name }}" fullImage></custom-salla-product-card>

				</div>
			{% endfor %}
		</div>
	</salla-slider>
</section>
