
<section class="s-block container overflow-hidden">
	<salla-slider
		type="carousel"
		centered
	>
		<div slot="items">
			{% for offer in component.offers %}
				<discount-product-card product-id="{{ offer.product[0] }}" offer-title="{{ offer.title }}"></discount-product-card> 
			{% endfor %}
		</div>
	</salla-slider>
</section>
