
<section class="s-block container overflow-hidden">
	{% if component.products|length %}
		<salla-slider
			block-title="{{ component.title }}"
			type="carousel"
			auto-height
		>
			<div slot="items">
				{% for product in component.products %}
					<div class="w-full flex flex-col md:flex-row gap-3">

						<div class="w-full h-full">
							<img class="h-full w-full object-cover" src="{{ product.image }}" />
						</div>

						<div class="w-full h-full flex justify-center flex-col items-center">
						</div>

					</div>
				{% endfor %}
			</div>
		</salla-slider>
	{% endif %}
</section>
