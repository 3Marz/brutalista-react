{#
| Variable        | Type   | Description        |
|-----------------|--------|--------------------|
| moving_text     | string | marquee text       |
| animation_speed |		   |                    |
| default_colors  | Bool   |                    |
| bg_color        | string |                    |
| border_color    | string |                    |
#}

<section class="{{ component.top_margin ? "s-block" : ""}} w-full">
	<div 
		class="marquee-container w-full whitespace-nowrap flex overflow-hidden py-2 border-y-2 {{ component.default_colors ? "bg-primary border-bc text-base-100" : "" }}"
		style="{{ component.default_colors ? "" : "
			background-color: #{component.bg_color};
			border-color: #{component.border_color};
			color: #{component.text_color};
		" }}"
	>

		{% for i in range(0, 10) %}
			<div 
				class="text-sm md:text-base px-5 rtl:animate-[marquee-effect-rtl_linear_infinite] ltr:animate-[marquee-effect-ltr_linear_infinite]"
				style="animation-duration: {{ component.animation_speed }}s;"
			>
				{{ component.moving_text }}
			</div>
		{% endfor %}

	</div>
</section>

