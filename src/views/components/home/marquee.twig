{#
| Variable       | Type   | Description        |
|----------------|--------|--------------------|
| moving_text    | string | marquee text       |
| default_colors | Bool   |                    |
| bg_color       | string |                    |
| border_color   | string |                    |
#}

<section class="s-block w-full">
	<div class="w-full justify-center whitespace-nowrap flex overflow-hidden py-2 border-y-2 {{ component.default_colors ? "bg-primary border-bc" : "bg-[#{ component.bg_color }] border-[#{ component.border-color }]" }}" >

		{% for i in range(0, 10) %}
			<div class="text-2xl px-5 animate-[marquee-effect_1s_linear_infinite]">
				{{ component.moving_text }}
			</div>
		{% endfor %}

	</div>
</section>

