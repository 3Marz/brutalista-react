{#
| Variable        | Type       | Description                                                      |
|-----------------|------------|------------------------------------------------------------------|
| display_all_url | ?string    | If it's existed, mean should show load more link to this url     |
| title           | string     |                                                                  |
| products        | Products[] |                                                                  |
| position        | Int        | Sorting number start from zero                                   |
| limit           | Int        | Number of products to be shown
#}
{% set is_vertical = theme.settings.get('vertical_fixed_products', true) %}
<section class="s-block container">

	<div class="p-2 flex flex-col gap-3">
		<div class="flex gap-3">
			<salla-button color="primary">
				primary
			</salla-button>

			<salla-button color="light">
				light
			</salla-button>

			<salla-button color="gray">
				gray
			</salla-button>

			<salla-button color="dark">
				dark
			</salla-button>

			<salla-button color="success">
				success
			</salla-button>

			<salla-button color="warning">
				warning
			</salla-button>

			<salla-button color="danger">
				danger
			</salla-button>
		</div>

		<div class="flex gap-3">
			<salla-button color="primary" fill="outline">
				primary
			</salla-button>

			<salla-button color="light" fill="outline">
				light
			</salla-button>

			<salla-button color="gray" fill="outline">
				gray
			</salla-button>

			<salla-button color="dark" fill="outline">
				dark
			</salla-button>

			<salla-button color="success" fill="outline">
				success
			</salla-button>

			<salla-button color="warning" fill="outline">
				warning
			</salla-button>

			<salla-button color="danger" fill="outline">
				danger
			</salla-button>
		</div>

		<div class="flex gap-3">
			<salla-button shape="btn">
				btn
			</salla-button>

			<salla-button shape="icon">
				icon
			</salla-button>

			<salla-button shape="link">
				link
			</salla-button>
		</div>
		<div class="flex gap-3">
			<salla-button shape="btn" fill="outline">
				btn
			</salla-button>

			<salla-button shape="icon" fill="outline">
				icon
			</salla-button>

			<salla-button shape="link" fill="outline">
				link
			</salla-button>
		</div>
		<div class="flex gap-3">
			<salla-button shape="btn" fill="none">
				btn
			</salla-button>

			<salla-button shape="icon" fill="none">
				icon
			</salla-button>

			<salla-button shape="link" fill="none">
				link
			</salla-button>
		</div>
		<div class="flex gap-3">
			<salla-button loading>
				loading
			</salla-button>
		</div>
	</div>

    {% if title %}
      <div class="s-block__title">
        <div class="right-side">
          <h2>{{ title }}</h2>
          {# <p>عنوان فرعي توصيفي صغير</p> #}
        </div>
        {% if display_all_url %}
            <a href="{{ display_all_url }}" class="s-block__display-all">{{ trans('blocks.home.display_all') }} <i class="sicon-arrow-left"></i></a>
        {% endif %}
      </div>
    {% endif %}

    <salla-products-list
      source="selected"
      limit="{{ limit }}"
      source-value="[{{ products|map((product) => product.id)|join(',') }}]"
      class="{{is_vertical ? 'vertical-products' : 'horizontal-products'}}"
      {{is_vertical ? '' : 'horizontal-cards'}}
      >
    </salla-products-list>
</section>


